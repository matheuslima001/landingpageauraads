# EditorConfig — https://editorconfig.org
# Coerente com a convenção do projeto: 2 espaços, UTF-8, LF.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Em Markdown, espaços finais podem ser semânticos (quebra de linha).
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
